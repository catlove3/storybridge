# Default OpenAI-compatible provider used by every current workflow skill.
# Base URL must end immediately before /chat/completions.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-name

# Optional key for the rewriter_ft profile in config/models.yaml.
LOCAL_FT_API_KEY=

# Optional network-deployment authentication: JSON API-key to owner mapping.
# STORYBRIDGE_API_KEYS={"replace-me":"local"}

# Optional runtime data isolation (defaults resolve under backend/data/).
# STORYBRIDGE_DATABASE_FILE=/persistent/storybridge/storybridge.sqlite3
# STORYBRIDGE_PROJECTS_DIR=/persistent/storybridge/projects
# STORYBRIDGE_JOBS_FILE=/persistent/storybridge/jobs.json
# STORYBRIDGE_SFT_LOG_DIR=/persistent/storybridge/sft_logs
# STORYBRIDGE_RUN_LOG_DIR=/persistent/storybridge/run_logs

# ./speed_run.sh --share migrates LLM_API_KEY to authenticated ciphertext.
# LLM_API_KEY_ENCRYPTED=...
# STORYBRIDGE_MASTER_KEY_FILE=/private/master.key
# Fixed HTTPS homepage; skip creation of a Quick Tunnel when provided to the launcher.
# STORYBRIDGE_PUBLIC_URL=https://stories.example.com
# STORYBRIDGE_VISITOR_DAILY_TOKENS=300000
# STORYBRIDGE_SITE_DAILY_TOKENS=100000000
# STORYBRIDGE_VISITOR_CONCURRENCY=1
# STORYBRIDGE_SITE_CONCURRENCY=32
# STORYBRIDGE_VISITOR_SUBMISSIONS_PER_MINUTE=6
# STORYBRIDGE_SITE_SUBMISSIONS_PER_MINUTE=120
