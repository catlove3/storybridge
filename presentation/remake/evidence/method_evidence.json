  "plan": {
    "culture_mechanism_id": "CM01",
    "original_name": "高考",
    "based_on_version": 1,
    "friction_level": "high",
    "options": [
      {
        "option_label": "A",
        "strategy": "preserve",
        "title": "保留中国高考，加注解释",
        "replacement_definition": "保留“高考”作为中国全国统一大学入学考试，在台词或旁白中自然解释其重要性，例如通过角色对话提及“这是决定我能不能上大学的唯一考试”。",
        "rationale": "对于熟悉亚洲教育体系的美国观众，高考概念并不完全陌生，保留原设定可以维持故事的中国背景和异域感，同时通过简洁注释降低理解门槛。",
        "preserved_functions": [
          "motivation",
          "constraint",
          "conflict",
          "revelation",
          "foreshadowing",
          "payoff",
          "status",
          "institutional_access",
          "economic_security",
          "reputation",
          "aspiration",
          "fear",
          "suspense",
          "satisfaction"
        ],
        "lost_functions": [],
        "risks": [
          "美国观众可能难以完全共情高考的极端重要性，导致情感投入不足。",
          "解释性台词可能显得生硬，影响节奏。"
        ]
      },
      {
        "option_label": "B",
