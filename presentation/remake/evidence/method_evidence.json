    "characters": [
      {
        "id": "C01",
        "name": "林知夏",
        "role": "protagonist",
        "description": "前世被沈曼借笔换分、推下天台致死；重生后设局反杀，最终以669分被录取。",
        "goals": [
          "阻止沈曼借笔换分",
          "揭露沈曼的换分与谋杀真相",
          "保护周雨并让沈曼受到法律制裁"
        ]
      },
      {
        "id": "C02",
        "name": "沈曼",
        "role": "antagonist",
        "description": "豪门千金，利用借笔换分系统窃取他人高考成绩，前世推林知夏坠楼；重生后误换周雨的笔，最终因故意杀人未遂被定罪。",
        "goals": [
          "窃取林知夏的669分",
          "掩盖换分与谋杀真相",
          "夺回被换错的487分"
        ]
      },
      {
        "id": "C03",
        "name": "周雨",
        "role": "supporting",
        "description": "林知夏的同学，笔被林知夏放入笔袋外层，成为换分目标；意外获得487分，与林知夏结盟直播揭露沈曼。",
        "goals": [
          "查明自己分数异常的原因",
          "与林知夏一起让沈曼付出代价",
          "保住487分并顺利录取"
        ]
      },
      {
        "id": "C04",
        "name": "母亲",
        "role": "minor",
        "description": "林知夏的母亲，前世因女儿487分崩溃，重生后见证女儿669分录取。",
        "goals": [
          "支持女儿高考",
          "保护女儿"
        ]
      },
      {
        "id": "C05",
        "name": "老陈",
        "role": "minor",
        "description": "林知夏的班主任，教龄二十年，前世对林知夏487分感到不可思议并申请复核。",
        "goals": [
          "帮助学生复核成绩",
          "维护考试公平"
        ]
      },
      {
        "id": "C06",
        "name": "法官",
        "role": "minor",
        "description": "庭审法官，明确不审理前世与系统，仅依据现实证据认定沈曼故意杀人未遂。",
        "goals": [
          "依法审理案件",
          "依据现实证据定罪"
        ]
      }
    ],
    "scenes": [
      {
        "id": "S01",
        "title": "前世·借笔",
        "summary": "高考最后一科前，沈曼向林知夏借笔，还笔时指尖在笔杆上停留半秒。"
      },
      {
        "id": "S02",
        "title": "前世·出分之夜",
        "summary": "林知夏查分487，复核驳回；沈曼以669分登顶，掌心蓝痕褪色。"
      },
      {
        "id": "S03",
        "title": "前世·天台",
        "summary": "沈曼在天台承认换分并推林知夏坠楼，伪装成自杀。"
      },
      {
        "id": "S04",
        "title": "重生·换牌",
        "summary": "林知夏重生回高考第一天，写下三条计划，并把周雨的笔放入笔袋最外层。"
      },
      {
        "id": "S05",
        "title": "重生·考场",
        "summary": "沈曼再次借笔，林知夏递出周雨的笔，沈曼还笔时指尖仍停半秒。"
      },
      {
        "id": "S06",
        "title": "重演·出分",
        "summary": "林知夏查得669，周雨查得487，沈曼只考了330并在班级群发截图。"
      },
      {
        "id": "S07",
        "title": "周雨的分数",
        "summary": "周雨复核确认487，沈曼脱口说出周雨原分330，暴露换分真相，周雨与林知夏结盟。"
      },
      {
        "id": "S08",
        "title": "结盟·设局",
        "summary": "沈曼电话威胁，林知夏录音并约她天台见面，周雨准备直播。"
      },
      {
        "id": "S09",
        "title": "天台·直播",
        "summary": "沈曼在天台说出换分规则，直播观看人数暴涨，她逼近林知夏。"
      },
      {
        "id": "S10",
        "title": "重演·落空与庭审",
        "summary": "沈曼推人落空，直播曝光，警察逮捕；庭审中法官以现实证据审理。"
      },
      {
        "id": "S11",
        "title": "清算",
        "summary": "沈曼因故意杀人未遂被定罪，升学资格取消；官方成绩维持不变，周雨确认录取。"
      },
      {
        "id": "S12",
        "title": "尾声",
        "summary": "林知夏与周雨分别收到669和487录取通知，笔被压在玻璃板下，笔杆深处蓝光一闪即灭。"
      }
    ],
