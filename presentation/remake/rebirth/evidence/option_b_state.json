      "id": "E03",
      "description": "班主任老陈帮忙申请复核，三天后被驳回，答复成绩无误。",
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "E04",
      "description": "沈曼以669分登上全校榜首，掌心蓝痕褪色。",
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "E05",
      "description": "沈曼在天台承认换分，并透露父亲花三百万买通复核。",
      "scene_ids": [
        "S03"
      ]
    },
    {
      "id": "E06",
      "description": "沈曼将林知夏推下天台，林知夏坠亡。",
      "scene_ids": [
        "S03"
      ]
    },
    {
      "id": "E07",
      "description": "林知夏重生回高考第一天清晨，确认时间与记忆一致。",
      "scene_ids": [
        "S04"
      ]
    },
    {
      "id": "E08",
      "description": "林知夏写下三行计划，并将周雨的笔放入笔袋最外层。",
      "scene_ids": [
        "S04"
      ]
    },
    {
      "id": "E09",
      "description": "沈曼再次借笔，林知夏借出周雨的笔，沈曼还笔时指尖停留半秒。",
      "scene_ids": [
        "S05"
      ]
    },
    {
      "id": "E10",
      "description": "林知夏查分得669分，与估分一致。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E11",
      "description": "周雨查分得487分，但估分仅330左右。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E12",
      "description": "沈曼查分仅得330分，在班级群发动态后沉默。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E13",
      "description": "周雨申请复核，被告知487分无误，但自己估分只有三百多。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E14",
      "description": "沈曼闯入林知夏家，抢过周雨手机看见487分后脱口而出'你明明只有330'，暴露自己知道周雨原分数。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E15",
      "description": "林知夏承认高考那天故意把周雨的笔借给沈曼，导致周雨被换分，周雨与林知夏决裂。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E16",
      "description": "沈曼打电话威胁林知夏'你找死'。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E17",
      "description": "林知夏在天台设局，用运动相机和录音笔录下沈曼承认换分，并告知日志有离线备份。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E18",
      "description": "警察、周雨、老宋到场，老宋手持系统日志打印件，沈曼被收网。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E19",
      "description": "林知夏根据前世记忆找到老宋，老宋展示'易分'模块日志，记录借笔人沈曼、被借笔人周雨、交换成功。",
      "scene_ids": [
        "S09"
      ]
    },
    {
      "id": "E20",
      "description": "日志新增状态'目标错误，建议回退'，证明系统自动识别换错，老宋将U盘交给林知夏。",
      "scene_ids": [
        "S09"
      ]
    },
    {
      "id": "E21",
      "description": "警方立案，沈曼律师主张'所谓系统根本不存在'。",
      "scene_ids": [
        "S10"
      ]
    },
    {
      "id": "E22",
      "description": "检方提交老宋离线日志、天台录音、沈曼查分当晚动态截图三样证据，法官质问沈曼为何第一反应是给林知夏打电话。",
      "scene_ids": [
        "S10"
      ]
    },
    {
      "id": "E23",
      "description": "官方通报沈曼因破坏计算机信息系统、故意杀人未遂被批准逮捕。",
      "scene_ids": [
        "S11"
      ]
    },
    {
      "id": "E24",
      "description": "沈曼父亲因三百万买通复核环节被查，行贿链条曝光，沈氏集团破产。",
      "scene_ids": [
        "S11"
      ]
    },
    {
      "id": "E25",
      "description": "周雨分数按卷面恢复，给林知夏发消息'分数回来了。但我们回不去了'，林知夏回复'嗯'。",
      "scene_ids": [
        "S11"
      ]
    },
