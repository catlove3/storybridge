      "description": "前世查分夜，林知夏查到487分，刷新十几次，母亲腿软坐倒，老陈申请复核。",
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "E03",
      "description": "三天后复核被驳回，答复只有四个字：成绩无误。",
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "E04",
      "description": "沈曼以669分登上全校榜首，采访中说超常发挥，掌心蓝痕正在褪色。",
      "scene_ids": [
        "S02"
      ]
    },
    {
      "id": "E05",
      "description": "前世志愿填报截止日，沈曼在天台承认换分，并透露其父花三百万买复核。",
      "scene_ids": [
        "S03"
      ]
    },
    {
      "id": "E06",
      "description": "沈曼在天台将林知夏推下坠楼，伪装成自杀。",
      "scene_ids": [
        "S03"
      ]
    },
    {
      "id": "E07",
      "description": "林知夏重生回高考第一天清晨，确认时间与记忆分毫不差。",
      "scene_ids": [
        "S04"
      ]
    },
    {
      "id": "E08",
      "description": "林知夏写下三条计划，并将周雨落下的笔放入笔袋最外层。",
      "scene_ids": [
        "S04"
      ]
    },
    {
      "id": "E09",
      "description": "重生后最后一科开考前，沈曼再次借笔，林知夏将周雨的笔借出，沈曼还笔时指尖停了半秒。",
      "scene_ids": [
        "S05"
      ]
    },
    {
      "id": "E10",
      "description": "重生后查分夜，林知夏查到669分，与估分一致。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E11",
      "description": "周雨查到487分，但估分只有330左右。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E12",
      "description": "沈曼在班级群发动态，配图查分截图330分，评论区询问后沈曼未再回复。",
      "scene_ids": [
        "S06"
      ]
    },
    {
      "id": "E13",
      "description": "周雨申请复核，被告知487分无误，但她估分只有三百多。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E14",
      "description": "沈曼闯入林知夏家，抢过周雨手机看见487后脱口而出'你明明只有330'，暴露自己知道原始分数。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E15",
      "description": "林知夏承认高考那天故意把周雨的笔借给沈曼，周雨愤而离去。",
      "scene_ids": [
        "S07"
      ]
    },
    {
      "id": "E16",
      "description": "沈曼打电话质问林知夏换笔，林知夏否认换笔但承认没借自己的笔，沈曼威胁'你找死'。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E17",
      "description": "天台对峙，林知夏以离线备份和日志记录威胁沈曼承认换分并归还周雨分数。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E18",
      "description": "沈曼扑向林知夏，林知夏侧身让开，沈曼撞上护栏；警察、周雨、老宋带着系统日志打印件赶到。",
      "scene_ids": [
        "S08"
      ]
    },
    {
      "id": "E19",
      "description": "三天前林知夏找到老宋，老宋展示易分系统日志：借笔人沈曼、被借笔人周雨、交换成功，三天后新增'目标错误，建议回退'。",
      "scene_ids": [
        "S09"
      ]
    },
    {
      "id": "E20",
      "description": "周雨得知自己的分数被系统判为'建议忽略'，老宋将U盘交给林知夏。",
      "scene_ids": [
        "S09"
      ]
    },
    {
      "id": "E21",
      "description": "警方立案，沈曼律师主张系统不存在，检方提交老宋离线日志、天台录音、沈曼动态截图三样证据。",
      "scene_ids": [
        "S10"
      ]
    },
    {
      "id": "E22",
      "description": "法官质问沈曼查分后第一反应为何是给林知夏打电话而非申请复核，沈曼无言以对。",
      "scene_ids": [
        "S10"
      ]
    },
    {
      "id": "E23",
      "description": "官方通报沈曼因破坏计算机信息系统、故意杀人未遂被批准逮捕，其父因三百万买通复核环节被查，沈氏集团破产。",
      "scene_ids": [
        "S11"
      ]
    },
    {
      "id": "E24",
      "description": "易分系统来源不明，已移交专门机构调查；周雨的分数按卷面恢复。",
      "scene_ids": [
        "S11"
      ]
    },
    {
      "id": "E25",
      "description": "周雨发消息'分数回来了。但我们回不去了'，林知夏回复'嗯'。",
      "scene_ids": [
        "S11"
      ]
    },
    {
      "id": "E26",
      "description": "林知夏收到录取通知，母亲擦了三遍信封才拆。",
      "scene_ids": [
        "S12"
      ]
    },
    {
      "id": "E27",
      "description": "周雨和林知夏互发消息，分别告知报考师范和法学，并解释原因。",
      "scene_ids": [
        "S12"
      ]
    },
    {
      "id": "E28",
      "description": "林知夏将周雨的笔放在书桌玻璃板下，并留下便签，但未扔掉笔。",
      "scene_ids": [
        "S12"
      ]
    }
  ],
  "settings": [
    {
      "id": "SET01",
      "name": "高考考场",
      "description": "中国普通高等学校招生全国统一考试的考场，考试期间考生可携带文具，考场外可短暂交流。"
    },
    {
      "id": "SET02",
      "name": "查分系统",
      "description": "高考成绩公布后，考生通过准考证号在指定网站或电话查询成绩的系统。"
    },
    {
      "id": "SET03",
      "name": "志愿填报",
      "description": "高考成绩公布后，考生在规定时间内填报高校志愿的流程，截止日期前可修改。"
    },
    {
      "id": "SET04",
      "name": "成绩复核",
      "description": "考生对成绩有异议时可申请复核，复核结果通常只确认分数无误，不重新评卷。"
    },
    {
      "id": "SET05",
      "name": "高考统分系统",
      "description": "中国高考分数统计与复核系统，存在可被非法模块'易分'篡改的漏洞，服务器数据可删但离线备份难删。"
    },
    {
      "id": "SET06",
      "name": "沈氏集团",
      "description": "沈曼家族企业，其父以三百万买通复核环节，行贿链条曝光后股价连跌、银行抽贷、宣告破产。"
    },
    {
      "id": "SET07",
      "name": "高考录取",
      "description": "中国的高考录取制度，录取通知书通过邮寄送达，是学生人生的重要转折点。"
    }
  ],
