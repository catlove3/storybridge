  "settings": [
    {
      "id": "SET01",
      "name": "高考",
      "description": "中国全国普通高等学校招生统一考试，决定学生大学录取，分数至关重要。"
    },
    {
      "id": "SET02",
      "name": "成绩复核",
      "description": "考生对成绩有异议可申请复核，但通常只核对分数加总，不重新评卷，且可能被暗箱操作。"
    },
    {
      "id": "SET03",
      "name": "豪门",
      "description": "指有钱有势的家族，其子女常被期待成绩优异，社会关注度高。"
    },
    {
      "id": "SET04",
      "name": "高考成绩公布与复核制度",
      "description": "中国高考成绩公布后，考生可申请复核分数；成绩一旦公布，通过换分笔进行的交换即锁死，无法更改。"
    },
    {
      "id": "SET05",
      "name": "换分笔系统",
      "description": "一支具有超自然能力的笔，借笔人的成绩会与笔主人最终公布的成绩对调，系统只认笔原来的主人。"
    },
    {
      "id": "SET06",
      "name": "前世记忆与重生",
      "description": "林知夏拥有前世被沈曼推下天台的记忆，今生利用记忆设局反击。"
    },
    {
      "id": "SET07",
      "name": "现实司法与教育体系",
      "description": "故事发生在当代中国，存在法院、教育部门、高考成绩系统、录取通知书等现实制度，但超自然交换无法被现实手段撤销。"
    }
  ],
